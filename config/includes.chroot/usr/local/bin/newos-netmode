#!/bin/sh
# newos-netmode: switch the network between tor / direct / offline.
# Usage: newos-netmode {tor|direct|offline|status}
set -eu
STATE=/run/newos/netmode
RULES=/etc/newos/nft

mode="${1:-status}"
case "$mode" in
  status)
    cat "$STATE" 2>/dev/null || echo unknown
    ;;
  tor|offline)
    [ "$(id -u)" -eq 0 ] || exec pkexec "$0" "$mode"
    nft -f "$RULES/$mode.nft"
    mkdir -p /run/newos && echo "$mode" > "$STATE"
    [ "$mode" = tor ] && systemctl start tor@default.service
    echo "network mode: $mode"
    ;;
  direct)
    [ "$(id -u)" -eq 0 ] || exec pkexec "$0" "$mode"
    if [ "${NEWOS_CONFIRM:-}" != yes ]; then
      printf 'Direct mode exposes your real IP. Type "direct" to confirm: '
      read -r answer
      [ "$answer" = direct ] || { echo "aborted"; exit 1; }
    fi
    nft -f "$RULES/direct.nft"
    mkdir -p /run/newos && echo direct > "$STATE"
    echo "network mode: direct (NOT anonymous)"
    ;;
  *)
    echo "usage: newos-netmode {tor|direct|offline|status}" >&2
    exit 2
    ;;
esac
