#!/bin/bash
# ragnarok-netpolicy: per-app network choices and the setup window.
#   ragnarok-netpolicy                 open the app network settings window
#   ragnarok-netpolicy get APP_ID      print the saved mode (or "ask")
#   ragnarok-netpolicy set APP_ID MODE save a mode
#   ragnarok-netpolicy ask APP_ID      show the setup window for one app, print the mode
#   ragnarok-netpolicy watch           pop the setup window when new apps get installed
set -u
USER_POL="${XDG_CONFIG_HOME:-$HOME/.config}/ragnarok/netpolicy"
SYS_POL=/etc/ragnarok/netpolicy.default
PENDING=/var/lib/ragnarok/pending-apps
MODES="tor tor-isolated direct offline"

# User choice wins over the system default (later file wins).
lookup() { local f files=(); for f in "$SYS_POL" "$USER_POL"; do [ -r "$f" ] && files+=("$f"); done
           [ ${#files[@]} -gt 0 ] && awk -v id="$1" '$1==id {m=$2} END {if (m) print m}' "${files[@]}"; }
get()    { m=$(lookup "$1"); echo "${m:-ask}"; }
set_()   { mkdir -p "$(dirname "$USER_POL")"; touch "$USER_POL"
           sed -i "/^$(printf '%s' "$1" | sed 's/[.[\*^$/]/\\&/g') /d" "$USER_POL"
           echo "$1 $2" >> "$USER_POL"; }
appname() {
  f=$(ls "/usr/local/share/applications/$1.desktop" "/usr/share/applications/$1.desktop" 2>/dev/null | head -1)
  n=$(sed -n 's/^Name=//p' "$f" 2>/dev/null | head -1); echo "${n:-$1}"
}
appicon() { sed -n 's/^Icon=//p' "/usr/share/applications/$1.desktop" 2>/dev/null | head -1; }

ask() {
  local id="$1" name cur choice
  name=$(appname "$id"); cur=$(lookup "$id"); cur="${cur:-tor}"
  on() { [ "$cur" = "$1" ] && echo on || echo off; }
  choice=$(kdialog --title "Network setup · $name" --icon "$(appicon "$id")" \
    --radiolist "<b>$name</b> can connect to the internet.<br>How should it connect?" \
    tor          "Through Tor (recommended)"                              "$(on tor)" \
    tor-isolated "Through Tor, with its own separate identity"             "$(on tor-isolated)" \
    direct       "Direct with my real IP address (NOT anonymous)"          "$(on direct)" \
    offline      "No network access"                                      "$(on offline)") || return 1
  if [ "$choice" = direct ]; then
    kdialog --title "Network setup · $name" --warningcontinuecancel \
      "$name will bypass Tor and reveal your real IP address and location to every site it contacts." \
      --continue-label "Use direct" || return 1
  fi
  set_ "$id" "$choice"
  echo "$choice"
}

settings() {
  local list=() id
  for f in /usr/local/share/applications/*.desktop; do
    id=$(basename "$f" .desktop)
    list+=("$id" "$(appname "$id")  ·  $(get "$id")")
  done
  [ ${#list[@]} -eq 0 ] && { kdialog --msgbox "No network apps found."; return; }
  while id=$(kdialog --title "Ragnarok · App network settings" \
               --menu "Pick an app to change how it connects:" "${list[@]}"); do
    ask "$id" >/dev/null
    exec "$0"   # reopen with refreshed labels
  done
}

watch() {
  mkdir -p "$(dirname "$USER_POL")"; touch "$USER_POL"
  while :; do
    if [ -r "$PENDING" ]; then
      while read -r id; do
        [ -n "$id" ] && [ -z "$(lookup "$id")" ] && ask "$id" >/dev/null
      done < "$PENDING"
    fi
    inotifywait -qq -e close_write -e moved_to "$(dirname "$PENDING")" 2>/dev/null || sleep 5
  done
}

case "${1:-settings}" in
  get) get "$2" ;;
  set) [[ " $MODES " == *" $3 "* ]] || { echo "mode must be one of: $MODES" >&2; exit 2; }; set_ "$2" "$3" ;;
  ask) ask "$2" ;;
  watch) watch ;;
  settings) settings ;;
  *) sed -n '2,8p' "$0"; exit 2 ;;
esac
