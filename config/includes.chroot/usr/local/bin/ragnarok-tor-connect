#!/bin/sh
# Ragnarok Tor connection screen. Shown at login before anything else.
# Nothing can reach the internet until Tor is connected: the firewall
# already blocks all non-Tor traffic, this window just shows progress
# and offers bridges if Tor can't get through.
set -u
P=/run/ragnarok/tor-progress
STUCK_AFTER=90

qdbus() { "$(command -v qdbus6 || command -v qdbus || echo /usr/lib/qt6/bin/qdbus)" "$@"; }

dbus=$(kdialog --title "Ragnarok · Connecting to Tor" --progressbar "Connecting to the Tor network…" 100)
ref=$(echo "$dbus" | cut -d' ' -f1); obj=$(echo "$dbus" | cut -d' ' -f2)
set_p() { qdbus "$ref" "$obj" Set "" value "$1" >/dev/null 2>&1; qdbus "$ref" "$obj" setLabelText "$2" >/dev/null 2>&1; }

start=$(date +%s)
while [ ! -e /run/ragnarok/tor-ready ]; do
  read -r pct sum < "$P" 2>/dev/null || { pct=0; sum="Starting Tor"; }
  set_p "$pct" "Connecting to Tor: $sum ($pct%)"
  if [ $(( $(date +%s) - start )) -gt $STUCK_AFTER ]; then
    qdbus "$ref" "$obj" close >/dev/null 2>&1
    if kdialog --title "Ragnarok · Tor" --yesno "Tor is taking a long time. This network may block Tor.\n\nConfigure a bridge (obfs4 or Snowflake)?"; then
      pkexec /usr/local/lib/ragnarok/tor-bridges && start=$(date +%s)
    else
      start=$(date +%s)
    fi
    dbus=$(kdialog --title "Ragnarok · Connecting to Tor" --progressbar "Connecting…" 100)
    ref=$(echo "$dbus" | cut -d' ' -f1); obj=$(echo "$dbus" | cut -d' ' -f2)
  fi
  sleep 1
done
set_p 100 "Connected to Tor. All traffic is routed through Tor."
sleep 2
qdbus "$ref" "$obj" close >/dev/null 2>&1
notify-send -a Ragnarok "Connected to Tor" "All traffic is routed through Tor." 2>/dev/null || true
