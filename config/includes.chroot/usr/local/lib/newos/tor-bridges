#!/bin/sh
# Root helper: switch Tor to Snowflake or user-supplied obfs4 bridges.
set -eu
choice=$(kdialog --title "NEWOS · Tor bridges" --radiolist "How should Tor connect?" \
  snowflake "Snowflake (works on most censored networks)" on \
  obfs4 "obfs4 bridges I paste in" off) || exit 1
conf=/etc/tor/torrc.d/bridges.conf
mkdir -p /etc/tor/torrc.d
case "$choice" in
  snowflake)
    # The Snowflake bridge line changes over time. The build copies the
    # current one from Tor Browser's built-in bridges into this file.
    { echo "UseBridges 1"; echo "ClientTransportPlugin snowflake exec /usr/bin/snowflake-client"
      cat /etc/newos/bridges/snowflake.lines; } > "$conf"
    ;;
  obfs4)
    lines=$(kdialog --title "NEWOS · obfs4" --textinputbox "Paste bridge lines (from bridges.torproject.org):" "") || exit 1
    { echo "UseBridges 1"; echo "ClientTransportPlugin obfs4 exec /usr/bin/obfs4proxy"
      echo "$lines" | sed '/^\s*$/d; s/^\(Bridge \)\{0,1\}/Bridge /'; } > "$conf"
    ;;
esac
systemctl restart tor@default.service
