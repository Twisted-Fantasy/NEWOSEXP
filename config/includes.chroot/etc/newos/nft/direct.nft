#!/usr/sbin/nft -f
# NEWOS "direct" mode: no Tor. For lab/LAN work where scans must use
# your real interface (raw SYN scans, UDP, ARP, Wi-Fi attacks).
# Inbound still blocked except replies.
flush ruleset

table inet newos_filter {
    chain input {
        type filter hook input priority 0; policy drop;
        iifname "lo" accept
        ct state established,related accept
        meta l4proto { icmp, ipv6-icmp } accept
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
    }
    chain output {
        type filter hook output priority 0; policy accept;
    }
}
