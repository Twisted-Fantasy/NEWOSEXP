#!/usr/sbin/nft -f
# Ragnarok "tor" mode: everything goes through Tor or nowhere.
# TCP -> Tor TransPort, DNS -> Tor DNSPort, everything else dropped.
flush ruleset

table ip ragnarok_nat {
    # Split mode: everything the workstation sends to the gateway goes to Tor
    chain prerouting {
        type nat hook prerouting priority -100; policy accept;
        iifname "veth-gw" ip daddr 10.152.152.10 tcp dport { 9050, 9060, 9150 } return
        iifname "veth-gw" udp dport 53 redirect to :53
        iifname "veth-gw" tcp dport 53 redirect to :53
        iifname "veth-gw" ip protocol tcp redirect to :9040
    }

    chain output {
        type nat hook output priority -100; policy accept;
        meta skuid "debian-tor" return
        # Per-app choices (see ragnarok-run): these groups skip the Tor redirect
        meta skgid { "ragnarok-direct", "ragnarok-offline" } return
        ip daddr 127.0.0.0/8 return
        udp dport 53 redirect to :5353
        tcp dport 53 redirect to :5353
        ip protocol tcp redirect to :9040
    }
}

table inet ragnarok_filter {
    chain input {
        type filter hook input priority 0; policy drop;
        iifname "lo" accept
        ct state established,related accept
        # Split mode: the workstation may reach Tor's ports and nothing else
        iifname "veth-gw" tcp dport { 53, 9040, 9050, 9060, 9150 } accept
        iifname "veth-gw" udp dport 53 accept
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
    }
    chain output {
        type filter hook output priority 0; policy drop;
        oifname "lo" accept
        # Apps set to "No network"
        meta skgid "ragnarok-offline" drop
        # Apps set to "Direct (real IP)"
        meta skgid "ragnarok-direct" accept
        meta skuid "debian-tor" ct state new,established,related accept
        # DHCP so NetworkManager can get an address
        meta nfproto ipv4 udp sport 68 udp dport 67 accept
        log prefix "ragnarok-leak-blocked: " level info limit rate 5/minute drop
    }
}
