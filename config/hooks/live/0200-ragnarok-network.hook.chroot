#!/bin/sh
# Tor-only firewall from the first moment of boot; Tor and its progress
# watcher start automatically. Per-app route groups created here.
set -e
groupadd --system ragnarok-direct  2>/dev/null || true
groupadd --system ragnarok-offline 2>/dev/null || true

systemctl enable ragnarok-firewall.service
systemctl enable tor.service
systemctl enable ragnarok-tor-watch.service

# proxychains -> dedicated isolated SOCKS port for tools
if [ -f /etc/proxychains4.conf ]; then
  sed -i 's/^socks4 \+127.0.0.1 \+9050/socks5 127.0.0.1 9060/' /etc/proxychains4.conf
fi

# Make sure no other firewall manager fights us
systemctl disable ufw.service 2>/dev/null || true

# DNS goes to Tor only: no local resolver in the way
systemctl mask systemd-resolved.service 2>/dev/null || true
rm -f /etc/resolv.conf.orig

# Split mode units (they only run when booted with ragnarok.split=1)
systemctl enable ragnarok-split.service ragnarok-split-forwarders.service
