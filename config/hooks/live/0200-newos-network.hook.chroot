#!/bin/sh
# Tor-only firewall from the first moment of boot; Tor and its progress
# watcher start automatically. Per-app route groups created here.
set -e
groupadd --system newos-direct  2>/dev/null || true
groupadd --system newos-offline 2>/dev/null || true

systemctl enable newos-firewall.service
systemctl enable tor.service
systemctl enable newos-tor-watch.service

# proxychains -> dedicated isolated SOCKS port for tools
if [ -f /etc/proxychains4.conf ]; then
  sed -i 's/^socks4 \+127.0.0.1 \+9050/socks5 127.0.0.1 9060/' /etc/proxychains4.conf
fi

# Make sure no other firewall manager fights us
systemctl disable ufw.service 2>/dev/null || true
