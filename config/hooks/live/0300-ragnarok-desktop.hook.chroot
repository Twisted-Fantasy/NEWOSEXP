#!/bin/sh
# Ragnarok look: boot splash, loading screen, desktop defaults.
set -e

# Live user logs straight in
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/ragnarok.conf <<'CONF'
[Autologin]
User=ghost
Session=plasma

[Theme]
Current=breeze
CONF


# Window frames: Aurorae is a separate package in newer Plasma releases.
# Install it if the archive has it, without failing the build if not.
apt-get install -y --no-install-recommends aurorae 2>/dev/null \
  || apt-get install -y --no-install-recommends kwin-decoration-aurorae 2>/dev/null \
  || echo "W: Aurorae package not found; window frames fall back to Breeze"

# Boot splash: set our Plymouth theme and rebuild the initramfs with it
plymouth-set-default-theme ragnarok
if command -v update-initramfs >/dev/null 2>&1; then
  update-initramfs -u -k all
elif command -v dracut >/dev/null 2>&1; then
  dracut --force --regenerate-all
fi
